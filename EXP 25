      "source": [
        "import re\n",
        "from email import message_from_string\n",
        "from urllib.parse import urlparse\n",
        "\n",
        "# Sample Email\n",
        "email_text = \"\"\"From: PayPal Support <support@paypa1.com>\n",
        "To: user@gmail.com\n",
        "Subject: Verify Your Account\n",
        "\n",
        "Dear Customer,\n",
        "\n",
        "Your account has been limited.\n",
        "Click here immediately:\n",
        "http://paypa1-security-login.com/verify\n",
        "\n",
        "Or visit:\n",
        "https://paypal.com\n",
        "\n",
        "Regards,\n",
        "PayPal Team\n",
        "\"\"\"\n",
        "\n",
        "# Parse Email\n",
        "msg = message_from_string(email_text)\n",
        "\n",
        "# Ensure sender and subject are strings, even if msg.get() returns None\n",
        "sender = msg.get(\"From\", \"\")\n",
        "subject = msg.get(\"Subject\", \"\")\n",
        "\n",
        "print(\"===== EMAIL DETAILS ====\")\n",
        "print(\"Sender :\", sender)\n",
        "print(\"Subject:\", subject)\n",
        "\n",
        "# Extract URLs\n",
        "urls = re.findall(r'https?://[^\\s]+', email_text)\n",
        "\n",
        "print(\"\\n===== URL ANALYSIS ====\")\n",
        "\n",
        "suspicious_count = 0\n",
        "\n",
        "for url in urls:\n",
        "    domain = urlparse(url).netloc\n",
        "\n",
        "    suspicious = False\n",
        "\n",
        "    if \"-\" in domain:\n",
        "        suspicious = True\n",
        "\n",
        "    if \"paypa1\" in domain:\n",
        "        suspicious = True\n",
        "\n",
        "    if domain.count(\".\") > 2:\n",
        "        suspicious = True\n",
        "\n",
        "    print(\"URL:\", url)\n",
        "\n",
        "    if suspicious:\n",
        "        print(\"Status: Suspicious\")\n",
        "        suspicious_count += 1\n",
        "    else:\n",
        "        print(\"Status: Legitimate\")\n",
        "\n",
        "# Sender Spoof Detection\n",
        "print(\"\\n===== SENDER CHECK ====\")\n",
        "\n",
        "if \"paypa1\" in sender.lower():\n",
        "    print(\"Possible Spoofed Sender\")\n",
        "else:\n",
        "    print(\"Sender looks normal\")\n",
        "\n",
        "# Risk Score\n",
        "score = suspicious_count * 40\n",
        "\n",
        "if \"paypa1\" in sender.lower():\n",
        "    score += 30\n",
        "\n",
        "score = min(score, 100)\n",
        "\n",
        "print(\"\\n===== RISK SCORE ====\")\n",
        "print(score, \"/100\")\n",
        "\n",
        "print(\"\\n===== SUMMARY ====\")\n",
        "print(\"URLs Found:\", len(urls))\n",
        "print(\"Suspicious URLs:\", suspicious_count)"
      ]
