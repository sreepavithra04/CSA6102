      "source": [
        "volatile_sources = [\n",
        "    'RAM',\n",
        "    'Cache',\n",
        "    'Running Processes',\n",
        "    'Network Connections',\n",
        "    'Swap File'\n",
        "]\n",
        "\n",
        "def classify(source):\n",
        "    if source in volatile_sources:\n",
        "        return 'Volatile'\n",
        "    else:\n",
        "        return 'Non-Volatile'\n",
        "\n",
        "evidence_sources = [\n",
        "    'RAM',\n",
        "    'Hard Disk',\n",
        "    'Cache',\n",
        "    'Registry Files'\n",
        "]\n",
        "\n",
        "for src in evidence_sources:\n",
        "    print(src, \":\", classify(src))"
