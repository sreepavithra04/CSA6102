        "    \"123456\",\n",
        "    \"Password\",\n",
        "    \"Welcome123\",\n",
        "    \"Strong@123\"\n",
        "]\n",
        "\n",
        "for pwd in passwords:\n",
        "\n",
        "    weak = False\n",
        "\n",
        "    if len(pwd) < 8:\n",
        "        weak = True\n",
        "\n",
        "    if pwd.lower() in [\"admin\", \"password\", \"123456\"]:\n",
        "        weak = True\n",
        "\n",
        "    if weak:\n",
        "        print(pwd, \"-> Weak\")\n",
        "    else:\n",
        "        print(pwd, \"-> Strong\")\n",
        "\n",
        "print(\"\\n===== SQL INJECTION DETECTION =====\")\n",
        "\n",
        "inputs = [\n",
        "    \"admin\",\n",
        "    \"' OR 1=1 --\",\n",
        "    \"hello\",\n",
        "    \"'; DROP TABLE users; --\"\n",
        "]\n",
        "\n",
        "pattern = r\"('.*--|OR\\s+1=1|DROP\\s+TABLE)\"\n",
        "\n",
        "for item in inputs:\n",
        "\n",
        "    if re.search(pattern, item, re.IGNORECASE):\n",
