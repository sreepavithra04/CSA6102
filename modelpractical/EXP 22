      "source": [
        "import csv\n",
        "\n",
        "baseline = {\n",
        "    \"a.txt\": \"AAA\",\n",
        "    \"b.txt\": \"BBB\",\n",
        "    \"c.txt\": \"CCC\"\n",
        "}\n",
        "\n",
        "snapshot = {\n",
        "    \"a.txt\": \"AAA\",\n",
        "    \"b.txt\": \"XXX\",\n",
        "    \"d.txt\": \"CCC\"\n",
        "}\n",
        "\n",
        "print(\"INTEGRITY COMPARISON\")\n",
        "print(\"--------------------\")\n",
        "\n",
        "for file in baseline:\n",
        "    if file not in snapshot:\n",
        "        # Check whether its hash exists under another name\n",
        "        if baseline[file] in snapshot.values():\n",
        "            print(\"Renamed:\", file)\n",
        "        else:\n",
        "            print(\"Missing:\", file)\n",
        "\n",
        "for file in snapshot:\n",
        "    if file not in baseline:\n",
        "        if snapshot[file] not in baseline.values():\n",
        "            print(\"New:\", file)\n",
        "\n",
        "for file in baseline:\n",
        "    if file in snapshot and baseline[file] != snapshot[file]:\n",
        "        print(\"Modified:\", file)"
      ]
