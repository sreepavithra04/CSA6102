        "import hashlib\n",
        "import os\n",
        "\n",
        "def verify(file):\n",
        "    with open(file, \"rb\") as f:\n",
        "        data = f.read()\n",
        "\n",
        "    return {\n",
        "        \"size\": os.path.getsize(file),\n",
        "        \"MD5\": hashlib.md5(data).hexdigest(),\n",
        "        \"SHA1\": hashlib.sha1(data).hexdigest(),\n",
        "        \"SHA256\": hashlib.sha256(data).hexdigest()\n",
        "    }\n",
        "\n",
        "original = \"original.img\"\n",
        "copy = \"working.img\"\n",
        "\n",
        "# Create sample files\n",
        "with open(original, \"wb\") as f:\n",
        "    f.write(b\"Forensic image data\")\n",
        "\n",
        "with open(copy, \"wb\") as f:\n",
        "    f.write(b\"Forensic image data\")\n",
        "\n",
        "a = verify(original)\n",
        "b = verify(copy)\n",
        "\n",
        "print(\"ORIGINAL:\", a)\n",
        "print(\"WORKING COPY:\", b)\n",
        "\n",
        "if a == b:\n",
        "    print(\"Result: Working copy matches original\")\n",
        "else:\n",
        "    print(\"Result: MISMATCH DETECTED\")\n",
        "\n",
        "    if a[\"size\"] != b[\"size\"]:\n",
        "        print(\"Mismatch: File size\")\n",
        "\n",
        "    for h in [\"MD5\", \"SHA1\", \"SHA256\"]:\n",
        "        if a[h] != b[h]:\n",
        "            print(\"Mismatch:\", h)"
      ]
