        "import socket\n",
        "from collections import defaultdict\n",
        "\n",
        "domains = [\n",
        "    \"google.com\",\n",
        "    \"example.com\",\n",
        "    \"python.org\",\n",
        "    \"invalid-domain-test-12345.com\"\n",
        "]\n",
        "\n",
        "ip_domains = defaultdict(list)\n",
        "\n",
        "print(\"DNS RECONNAISSANCE SUMMARY\")\n",
        "print(\"--------------------------\")\n",
        "\n",
        "for domain in domains:\n",
        "    try:\n",
        "        ip = socket.gethostbyname(domain)\n",
        "        print(domain, \"->\", ip)\n",
        "        ip_domains[ip].append(domain)\n",
        "    except socket.gaierror:\n",
        "        print(domain, \"-> Resolution Failed\")\n",
        "\n",
        "print(\"\\nDOMAINS SHARING IP\")\n",
        "print(\"------------------\")\n",
        "\n",
        "for ip, names in ip_domains.items():\n",
        "    if len(names) > 1:\n",
        "        print(ip, \":\", names)"
      ]
