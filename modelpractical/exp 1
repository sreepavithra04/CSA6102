      "source": [
        "import hashlib\n",
        "from datetime import datetime\n",
        "\n",
        "# Create sample evidence file\n",
        "with open(\"evidence.txt\", \"w\") as f:\n",
        "    f.write(\"Forensic evidence sample\")\n",
        "\n",
        "class Evidence:\n",
        "    def __init__(self, eid, file, source, investigator, location):\n",
        "        self.eid = eid\n",
        "        self.file = file\n",
        "        self.source = source\n",
        "        self.investigator = investigator\n",
        "        self.location = location\n",
        "        self.time = datetime.now()\n",
        "        self.hash = self.get_hash()\n",
        "        self.custody = []\n",
        "\n",
        "    def get_hash(self):\n",
        "        with open(self.file, \"rb\") as f:\n",
        "            return hashlib.sha256(f.read()).hexdigest()\n",
        "\n",
        "    def add_custody(self, person, action):\n",
        "        self.custody.append((person, action, datetime.now()))\n",
        "\n",
        "    def display(self):\n",
        "        print(\"Evidence ID:\", self.eid)\n",
        "        print(\"Source:\", self.source)\n",
        "        print(\"Investigator:\", self.investigator)\n",
        "        print(\"Location:\", self.location)\n",
        "        print(\"Acquired:\", self.time)\n",
        "        print(\"SHA-256:\", self.hash)\n",
        "\n",
        "        print(\"\\nCustody History:\")\n",
        "        for c in self.custody:\n",
        "            print(c)\n",
        "\n",
        "        print(\"Integrity:\",\n",
        "              \"Verified\" if self.hash == self.get_hash() else \"Changed\")\n",
        "\n",
        "\n",
        "e = Evidence(\"EX-01\", \"evidence.txt\", \"Computer-01\",\n",
        "             \"Investigator A\", \"Evidence Locker\")\n",
        "\n",
        "e.add_custody(\"Investigator A\", \"Collected\")\n",
        "e.add_custody(\"Investigator B\", \"Examined\")\n",
        "e.display()"
      ]
