        "legitimate = [\n",
        "    \"google.com\",\n",
        "    \"microsoft.com\",\n",
        "    \"amazon.com\"\n",
        "]\n",
        "\n",
        "suspicious = [\n",
        "    \"g00gle.com\",\n",
        "    \"google-login.com\",\n",
        "    \"micros0ft.com\",\n",
        "    \"amazon-security.com\"\n",
        "]\n",
        "\n",
        "for bad in suspicious:\n",
        "    best = \"\"\n",
        "    score = 0\n",
        "\n",
        "    for good in legitimate:\n",
        "        # Compare characters\n",
        "        common = sum(a == b for a, b in zip(bad, good))\n",
        "\n",
        "        if common > score:\n",
        "            score = common\n",
        "            best = good\n",
        "\n",
        "    print(\"Suspicious Domain:\", bad)\n",
        "    print(\"Closest Legitimate:\", best)\n",
        "    print()"
