            "PROCESS HIERARCHY\n",
            "-----------------\n",
            "explorer.exe\n",
            "  -> cmd.exe\n",
            "cmd.exe\n",
            "  -> notepad.exe\n",
            "  -> powershell.exe\n",
            "winword.exe\n",
            "  -> powershell.exe\n",
            "\n",
            "SUSPICIOUS PROCESSES\n",
            "--------------------\n",
            "Suspicious: powershell.exe\n",
            "Parent: cmd.exe\n",
            "Suspicious: powershell.exe\n",
            "Parent: winword.exe\n"
          ]
        }
      ],
      "source": [
        "from collections import defaultdict\n",
        "\n",
        "logs = [\n",
        "    (\"explorer.exe\", \"cmd.exe\"),\n",
        "    (\"cmd.exe\", \"notepad.exe\"),\n",
        "    (\"cmd.exe\", \"powershell.exe\"),\n",
        "    (\"winword.exe\", \"powershell.exe\")\n",
        "]\n",
        "\n",
        "# Expected parent-child relationships\n",
        "expected = {\n",
        "    \"explorer.exe\": [\"cmd.exe\", \"notepad.exe\"],\n",
        "    \"cmd.exe\": [\"notepad.exe\"],\n",
        "    \"winword.exe\": [\"winword.exe\"]\n",
        "}\n",
        "\n",
        "tree = defaultdict(list)\n",
        "\n",
        "for parent, child in logs:\n",
        "    tree[parent].append(child)\n",
        "\n",
        "print(\"PROCESS HIERARCHY\")\n",
        "print(\"-----------------\")\n",
        "\n",
        "for parent, children in tree.items():\n",
        "    print(parent)\n",
        "    for child in children:\n",
        "        print(\"  ->\", child)\n",
        "\n",
        "print(\"\\nSUSPICIOUS PROCESSES\")\n",
        "print(\"--------------------\")\n",
        "\n",
        "for parent, child in logs:\n",
        "    if child not in expected.get(parent, []):\n",
        "        print(\"Suspicious:\", child)\n",
        "        print(\"Parent:\", parent)"
      ]
    }
