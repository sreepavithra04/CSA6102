            "Horizontal Scanning:\n",
            "('10.0.0.1', 80) -> {'192.168.1.2', '192.168.1.3', '192.168.1.1'}\n",
            "\n",
            "Vertical Scanning:\n",
            "('10.0.0.2', '192.168.1.5') -> {21, 22, 23}\n"
