      ],
      "source": [
        "from collections import defaultdict\n",
        "\n",
        "logs = [\n",
        "    (\"10.0.0.1\", \"192.168.1.1\", 80),\n",
        "    (\"10.0.0.1\", \"192.168.1.2\", 80),\n",
        "    (\"10.0.0.1\", \"192.168.1.3\", 80),\n",
        "    (\"10.0.0.2\", \"192.168.1.5\", 21),\n",
        "    (\"10.0.0.2\", \"192.168.1.5\", 22),\n",
        "    (\"10.0.0.2\", \"192.168.1.5\", 23)\n",
        "]\n",
        "\n",
        "horizontal = defaultdict(set)\n",
        "vertical = defaultdict(set)\n",
        "\n",
        "for src, dst, port in logs:\n",
        "    horizontal[(src, port)].add(dst)\n",
        "    vertical[(src, dst)].add(port)\n",
        "\n",
        "print(\"Horizontal Scanning:\")\n",
        "for key, hosts in horizontal.items():\n",
        "    if len(hosts) >= 3:\n",
        "        print(key, \"->\", hosts)\n",
        "\n",
        "print(\"\\nVertical Scanning:\")\n",
        "for key, ports in vertical.items():\n",
        "    if len(ports) >= 3:\n",
        "        print(key, \"->\", ports)"
      ]
    }
