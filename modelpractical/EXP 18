          "text": [
            "FILE SYSTEM ACTIVITY\n",
            "--------------------\n",
            "E01 file1.txt Creation\n",
            "E02 file2.txt Creation\n",
            "E03 file1.txt Modification\n",
            "E04 file1.txt Modification\n",
            "E05 file2.txt Deletion\n",
            "\n",
            "SUMMARY\n",
            "Creations: 2\n",
            "Modifications: 2\n",
            "Deletions: 1\n",
            "\n",
            "Most Frequently Affected:\n",
            "[('file1.txt', 3)]\n"
          ]
        }
      ],
      "source": [
        "events = [\n",
        "    (\"E01\", \"file1.txt\", \"Creation\"),\n",
        "    (\"E02\", \"file2.txt\", \"Creation\"),\n",
        "    (\"E03\", \"file1.txt\", \"Modification\"),\n",
        "    (\"E04\", \"file1.txt\", \"Modification\"),\n",
        "    (\"E05\", \"file2.txt\", \"Deletion\")\n",
        "]\n",
        "\n",
        "counts = {\n",
        "    \"Creation\": 0,\n",
        "    \"Modification\": 0,\n",
        "    \"Deletion\": 0\n",
        "}\n",
        "\n",
        "print(\"FILE SYSTEM ACTIVITY\")\n",
        "print(\"--------------------\")\n",
        "\n",
        "for event, file, action in events:\n",
        "    print(event, file, action)\n",
        "    counts[action] += 1\n",
        "\n",
        "print(\"\\nSUMMARY\")\n",
        "print(\"Creations:\", counts[\"Creation\"])\n",
        "print(\"Modifications:\", counts[\"Modification\"])\n",
        "print(\"Deletions:\", counts[\"Deletion\"])\n",
        "\n",
        "from collections import Counter\n",
        "\n",
        "files = Counter(e[1] for e in events)\n",
        "\n",
        "print(\"\\nMost Frequently Affected:\")\n",
        "print(files.most_common(1))"
      ]
    }
