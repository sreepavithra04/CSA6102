        "import os\n",
        "\n",
        "folder = \"test_folder\"\n",
        "\n",
        "# Create sample directory\n",
        "os.makedirs(folder, exist_ok=True)\n",
        "\n",
        "open(folder + \"/normal.txt\", \"w\").write(\"data\")\n",
        "open(folder + \"/.hidden.txt\", \"w\").write(\"secret\")\n",
        "open(folder + \"/empty.txt\", \"w\").close()\n",
        "\n",
        "print(\"CONCEALED OBJECT REPORT\")\n",
        "print(\"-----------------------\")\n",
        "\n",
        "for name in os.listdir(folder):\n",
        "    path = os.path.join(folder, name)\n",
        "    size = os.path.getsize(path)\n",
        "    warnings = []\n",
        "\n",
        "    if name.startswith(\".\"):\n",
        "        warnings.append(\"Hidden filename\")\n",
        "\n",
        "    if size == 0:\n",
        "        warnings.append(\"Zero-size file\")\n",
        "\n",
        "    if \" \" in name:\n",
        "        warnings.append(\"Unusual filename\")\n",
        "\n",
        "    print(\"\\nFile:\", name)\n",
        "    print(\"Size:\", size)\n",
        "\n",
        "    if warnings:\n",
        "        print(\"Examination Required:\", \", \".join(warnings))\n",
        "    else:\n",
        "        print(\"Status: Ordinary\")"
      ]
