      "source": [
        "from collections import defaultdict\n",
        "\n",
        "logs = [\n",
        "    (\"2026-08-28 09:00\", \"USB001\", \"Alice\"),\n",
        "    (\"2026-08-29 10:30\", \"USB002\", \"Bob\"),\n",
        "    (\"2026-08-30 11:00\", \"USB001\", \"Alice\"),\n",
        "    (\"2026-08-31 14:00\", \"USB001\", \"Alice\")\n",
        "]\n",
        "\n",
        "devices = defaultdict(list)\n",
        "\n",
        "for time, device, user in logs:\n",
        "    devices[device].append((time, user))\n",
        "\n",
        "print(\"USB DEVICE USAGE HISTORY\")\n",
        "print(\"------------------------\")\n",
        "\n",
        "for device, records in devices.items():\n",
        "    print(\"\\nDevice:\", device)\n",
        "    print(\"First Connected:\", records[0][0])\n",
        "    print(\"Connection Count:\", len(records))\n",
        "\n",
        "    for time, user in records:\n",
        "        print(time, \"-\", user)\n",
        "\n",
        "    if len(records) > 1:\n",
        "        print(\"Previously Recognized: Yes\")\n",
        "    else:\n",
        "        print(\"Previously Recognized: No\")"
      ]
