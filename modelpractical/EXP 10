      "source": [
        "# Create sample notes file\n",
        "with open(\"notes.txt\", \"w\") as f:\n",
        "    f.write(\"\"\"Evidence: EX-01\n",
        "Observation: File found on suspect system\n",
        "Step: SHA-256 hash calculated\n",
        "Finding: Hash matched original value\n",
        "\"\"\")\n",
        "\n",
        "sections = {\n",
        "    \"Evidence\": [],\n",
        "    \"Observation\": [],\n",
        "    \"Step\": [],\n",
        "    \"Finding\": []\n",
        "}\n",
        "\n",
        "with open(\"notes.txt\", \"r\") as f:\n",
        "    for line in f:\n",
        "        if \":\" in line:\n",
        "            key, value = line.strip().split(\":\", 1)\n",
        "\n",
        "            if key in sections:\n",
        "                sections[key].append(value.strip())\n",
        "\n",
        "print(\"FORENSIC EXAMINATION SUMMARY\")\n",
        "print(\"=\" * 35)\n",
        "\n",
        "for section, values in sections.items():\n",
        "    print(\"\\n\" + section.upper())\n",
        "\n",
        "    for value in values:\n",
        "        print(\"-\", value)"
      ]
