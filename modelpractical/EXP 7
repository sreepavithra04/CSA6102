            "Anomaly: Alice - Successful login after many failures\n",
            "Anomaly: Alice - New source IP: 10.0.0.5\n",
            "Anomaly: Bob - Login at unusual time\n"
          ]
        }
      ],
      "source": [
        "from collections import defaultdict\n",
        "\n",
        "logs = [\n",
        "    (\"Alice\", \"10.0.0.1\", 10, \"FAIL\"),\n",
        "    (\"Alice\", \"10.0.0.1\", 10, \"FAIL\"),\n",
        "    (\"Alice\", \"10.0.0.1\", 10, \"FAIL\"),\n",
        "    (\"Alice\", \"10.0.0.5\", 10, \"SUCCESS\"),\n",
        "    (\"Bob\", \"10.0.0.9\", 2, \"SUCCESS\")\n",
        "]\n",
        "\n",
        "failures = defaultdict(int)\n",
        "known_ips = defaultdict(set)\n",
        "\n",
        "for user, ip, hour, status in logs:\n",
        "\n",
        "    if status == \"FAIL\":\n",
        "        failures[user] += 1\n",
        "\n",
        "    if status == \"SUCCESS\" and failures[user] >= 3:\n",
        "        print(\"Anomaly:\", user,\n",
        "              \"- Successful login after many failures\")\n",
        "\n",
        "    if hour < 6 or hour > 22:\n",
        "        print(\"Anomaly:\", user,\n",
        "              \"- Login at unusual time\")\n",
        "\n",
        "    if ip not in known_ips[user] and known_ips[user]:\n",
        "        print(\"Anomaly:\", user,\n",
        "              \"- New source IP:\", ip)\n",
        "\n",
        "    known_ips[user].add(ip)"
      ]
