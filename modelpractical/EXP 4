          ]
        }
      ],
      "source": [
        "from collections import defaultdict\n",
        "\n",
        "logs = [\n",
        "    (\"10.1.1.5\", 22, \"10:00\"),\n",
        "    (\"10.1.1.5\", 22, \"10:05\"),\n",
        "    (\"10.1.1.5\", 22, \"10:10\"),\n",
        "    (\"10.1.1.8\", 23, \"11:00\"),\n",
        "    (\"10.1.1.8\", 23, \"11:05\")\n",
        "]\n",
        "\n",
        "groups = defaultdict(list)\n",
        "\n",
        "for ip, port, time in logs:\n",
        "    groups[(ip, port)].append(time)\n",
        "\n",
        "print(\"Firewall Findings:\")\n",
        "\n",
        "for key, times in groups.items():\n",
        "    print(\"\\nSource:\", key[0])\n",
        "    print(\"Port:\", key[1])\n",
        "    print(\"Attempts:\", len(times))\n",
        "    print(\"Timestamps:\", times)\n",
        "\n",
        "    if len(times) >= 3:\n",
        "        print(\"Status: Persistent Activity\")\n",
        "    else:\n",
        "        print(\"Status: Normal\")"
      ]
    }
