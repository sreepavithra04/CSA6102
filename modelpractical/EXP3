      "source": [
        "from collections import defaultdict\n",
        "\n",
        "logs = [\n",
        "    (\"report.docx\", \"Alice\", \"Word\", \"2026-08-30 10:00\", \"Open\"),\n",
        "    (\"data.xlsx\", \"Bob\", \"Excel\", \"2026-08-30 11:00\", \"Open\"),\n",
        "    (\"report.docx\", \"Bob\", \"Word\", \"2026-08-30 12:00\", \"Edit\"),\n",
        "    (\"photo.jpg\", \"Alice\", \"Photos\", \"2026-08-30 09:00\", \"Open\")\n",
        "]\n",
        "\n",
        "logs.sort(key=lambda x: x[3], reverse=True)\n",
        "\n",
        "print(\"Recently Used Documents:\")\n",
        "for x in logs:\n",
        "    print(x)\n",
        "\n",
        "users = defaultdict(set)\n",
        "\n",
        "for file, user, app, time, activity in logs:\n",
        "    users[file].add(user)\n",
        "\n",
        "print(\"\\nFiles Accessed By Multiple Users:\")\n",
        "for file, user_list in users.items():\n",
        "    if len(user_list) > 1:\n",
        "        print(file, \"->\", user_list)"
