      "source": [
        "import os\n",
        "\n",
        "# Create sample files\n",
        "files = {\n",
        "    \"document.pdf\": b\"%PDF-1.4 Sample PDF\",\n",
        "    \"image.jpg\": b\"\\x89PNG Sample Image\",\n",
        "    \"archive.zip\": b\"PK Sample Archive\",\n",
        "    \"program.exe\": b\"MZ Sample Program\"\n",
        "}\n",
        "\n",
        "for name, data in files.items():\n",
        "    with open(name, \"wb\") as f:\n",
        "        f.write(data)\n",
        "\n",
        "signatures = {\n",
        "    \".pdf\": b\"%PDF\",\n",
        "    \".jpg\": b\"\\xff\\xd8\\xff\",\n",
        "    \".png\": b\"\\x89PNG\",\n",
        "    \".zip\": b\"PK\",\n",
        "    \".exe\": b\"MZ\"\n",
        "}\n",
        "\n",
        "for file in files:\n",
        "    ext = os.path.splitext(file)[1]\n",
        "\n",
        "    with open(file, \"rb\") as f:\n",
        "        header = f.read(8)\n",
        "\n",
        "    detected = \"Unknown\"\n",
        "\n",
        "    for e, sig in signatures.items():\n",
        "        if header.startswith(sig):\n",
        "            detected = e\n",
        "\n",
        "    print(\"\\nFile:\", file)\n",
        "    print(\"Extension:\", ext)\n",
        "    print(\"Detected Type:\", detected)\n",
        "\n",
        "    if ext == detected:\n",
        "        print(\"Result: Valid\")\n",
        "    else:\n",
        "        print(\"WARNING: Extension mismatch\")"
      ]
    }
