      "source": [
        "events = [\n",
        "    (\"10:00\", \"File Activity\", \"report.docx opened\"),\n",
        "    (\"10:02\", \"Authentication\", \"Alice login\"),\n",
        "    (\"10:03\", \"Browser\", \"Website visited\"),\n",
        "    (\"10:04\", \"Network\", \"Connection established\"),\n",
        "    (\"11:00\", \"File Activity\", \"image.jpg modified\"),\n",
        "    (\"11:30\", \"Network\", \"Data transferred\")\n",
        "]\n",
        "\n",
        "events.sort(key=lambda x: x[0])\n",
        "\n",
        "print(\"CORRELATED FORENSIC TIMELINE\")\n",
        "print(\"----------------------------\")\n",
        "\n",
        "for time, source, activity in events:\n",
        "    print(time, \"|\", source, \"|\", activity)\n",
        "\n",
        "print(\"\\nCLOSELY RELATED ACTIVITIES\")\n",
        "print(\"--------------------------\")\n",
        "\n",
        "for i in range(len(events) - 1):\n",
        "    t1 = int(events[i][0].replace(\":\", \"\"))\n",
        "    t2 = int(events[i + 1][0].replace(\":\", \"\"))\n",
        "\n",
        "    if t2 - t1 <= 2:\n",
        "        print(events[i])\n",
        "        print(events[i + 1])\n",
        "        print()"
