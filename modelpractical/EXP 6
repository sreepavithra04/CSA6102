      "source": [
        "from PIL import Image\n",
        "\n",
        "# Create two sample images\n",
        "img1 = Image.new(\"RGB\", (800, 600), \"white\")\n",
        "img1.save(\"image1.jpg\")\n",
        "\n",
        "img2 = Image.new(\"RGB\", (1024, 768), \"white\")\n",
        "img2.save(\"image2.jpg\")\n",
        "\n",
        "\n",
        "def get_metadata(file):\n",
        "    img = Image.open(file)\n",
        "\n",
        "    data = {}\n",
        "\n",
        "    # Get EXIF metadata\n",
        "    exif = img.getexif()\n",
        "\n",
        "    for key, value in exif.items():\n",
        "        data[key] = value\n",
        "\n",
        "    # Store image dimensions\n",
        "    data[\"Dimensions\"] = img.size\n",
        "\n",
        "    return data\n",
        "\n",
        "\n",
        "a = get_metadata(\"image1.jpg\")\n",
        "b = get_metadata(\"image2.jpg\")\n",
        "\n",
        "fields = [\n",
        "    \"Make\",\n",
        "    \"Model\",\n",
        "    \"DateTime\",\n",
        "    \"Orientation\",\n",
        "    \"GPSInfo\",\n",
        "    \"Dimensions\"\n",
        "]\n",
        "\n",
        "print(\"IMAGE METADATA COMPARISON\")\n",
        "print(\"-------------------------\")\n",
        "\n",
        "for field in fields:\n",
        "\n",
        "    if field == \"Dimensions\":\n",
        "        x = a.get(field)\n",
        "        y = b.get(field)\n",
        "    else:\n",
        "        # Common EXIF tag numbers\n",
        "        tags = {\n",
        "            \"Make\": 271,\n",
        "            \"Model\": 272,\n",
        "            \"DateTime\": 306,\n",
        "            \"Orientation\": 274,\n",
        "            \"GPSInfo\": 34853\n",
        "        }\n",
        "\n",
        "        x = a.get(tags[field])\n",
        "        y = b.get(tags[field])\n",
        "\n",
        "    if x is None or y is None:\n",
        "        result = \"Unavailable\"\n",
        "    elif x == y:\n",
        "        result = \"Identical\"\n",
        "    else:\n",
        "        result = \"Different\"\n",
        "\n",
        "    print(field, \":\", result)"
      ],
