            "TRAFFIC STATISTICS\n",
            "------------------\n",
            "Time: 10:0 Destination: 192.168.1.10 Packets: 3\n",
            "Time: 10:1 Destination: 192.168.1.20 Packets: 6\n",
            "\n",
            "TRAFFIC SPIKES\n",
