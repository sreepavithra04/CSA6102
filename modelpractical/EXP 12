      ],
      "source": [
        "from collections import defaultdict\n",
        "\n",
        "# time, destination\n",
        "packets = [\n",
        "    (\"10:00\", \"192.168.1.10\"),\n",
        "    (\"10:01\", \"192.168.1.10\"),\n",
        "    (\"10:02\", \"192.168.1.10\"),\n",
        "    (\"10:10\", \"192.168.1.20\"),\n",
        "    (\"10:11\", \"192.168.1.20\"),\n",
        "    (\"10:12\", \"192.168.1.20\"),\n",
        "    (\"10:12\", \"192.168.1.20\"),\n",
        "    (\"10:12\", \"192.168.1.20\"),\n",
        "    (\"10:12\", \"192.168.1.20\")\n",
        "]\n",
        "\n",
        "window = defaultdict(int)\n",
        "\n",
        "for time, destination in packets:\n",
        "    minute = time[:4]\n",
        "    window[(minute, destination)] += 1\n",
        "\n",
        "print(\"TRAFFIC STATISTICS\")\n",
        "print(\"------------------\")\n",
        "\n",
        "for key, count in window.items():\n",
        "    print(\"Time:\", key[0],\n",
        "          \"Destination:\", key[1],\n",
        "          \"Packets:\", count)\n",
        "\n",
        "print(\"\\nTRAFFIC SPIKES\")\n",
        "print(\"--------------\")\n",
        "\n",
        "for key, count in window.items():\n",
        "    if count >= 4:\n",
        "        print(\"Spike detected\")\n",
        "        print(\"Time:\", key[0])\n",
        "        print(\"Destination:\", key[1])\n",
        "        print(\"Packets:\", count)"
      ]
