        "import hashlib\n",
        "\n",
        "database = {}\n",
        "\n",
        "def get_hash(file):\n",
        "    with open(file, \"rb\") as f:\n",
        "        return hashlib.sha256(f.read()).hexdigest()\n",
        "\n",
        "def add_file(file, evidence_id):\n",
        "    h = get_hash(file)\n",
        "    database[h] = evidence_id\n",
        "    print(\"Stored:\", evidence_id, h)\n",
        "\n",
        "def search_file(file):\n",
        "    h = get_hash(file)\n",
        "\n",
        "    if h in database:\n",
        "        print(\"MATCH FOUND\")\n",
        "        print(\"Evidence ID:\", database[h])\n",
        "    else:\n",
        "        print(\"No matching evidence found\")\n",
        "\n",
        "# Create sample files\n",
        "with open(\"evidence1.txt\", \"w\") as f:\n",
        "    f.write(\"Forensic data\")\n",
        "\n",
        "with open(\"copy.txt\", \"w\") as f:\n",
        "    f.write(\"Forensic data\")\n",
        "\n",
        "add_file(\"evidence1.txt\", \"EX-01\")\n",
        "\n",
        "print(\"\\nExamining copy:\")\n",
        "search_file(\"copy.txt\")"
      ]
    }
