      "source": [
        "baseline = [\n",
        "    (\"google.com\", \"HTTPS\", 10, 500),\n",
        "    (\"example.com\", \"HTTPS\", 12, 400),\n",
        "    (\"dns.com\", \"DNS\", 5, 50)\n",
        "]\n",
        "\n",
        "new_logs = [\n",
        "    (\"google.com\", \"HTTPS\", 10, 500),\n",
        "    (\"unknown.com\", \"FTP\", 2, 5000),\n",
        "    (\"dns.com\", \"DNS\", 5, 50)\n",
        "]\n",
        "\n",
        "destinations = {x[0] for x in baseline}\n",
        "protocols = {x[1] for x in baseline}\n",
        "max_volume = max(x[3] for x in baseline)\n",
        "\n",
        "print(\"Traffic Anomalies:\")\n",
        "\n",
        "for record in new_logs:\n",
        "    dest, protocol, time, volume = record\n",
        "    violations = []\n",
        "\n",
        "    if dest not in destinations:\n",
        "        violations.append(\"New destination\")\n",
        "\n",
        "    if protocol not in protocols:\n",
        "        violations.append(\"New protocol\")\n",
        "\n",
        "    if volume > max_volume * 2:\n",
        "        violations.append(\"High transfer volume\")\n",
        "\n",
        "    if violations:\n",
        "        print(\"\\nRecord:\", record)\n",
        "        print(\"Violated:\", \", \".join(violations))"
      ]
    }
