            "Domains: ['example.com', 'example.net']\n"
          ]
        }
      ],
      "source": [
        "domains = [\n",
        "    {\n",
        "        \"domain\": \"example.com\",\n",
        "        \"registrar\": \"Registrar-A\",\n",
        "        \"registered\": \"2020-01-10\",\n",
        "        \"expires\": \"2027-01-10\",\n",
        "        \"nameserver\": \"ns1.example.com\"\n",
        "    },\n",
        "    {\n",
        "        \"domain\": \"example.net\",\n",
        "        \"registrar\": \"Registrar-A\",\n",
        "        \"registered\": \"2021-02-15\",\n",
        "        \"expires\": \"2027-02-15\",\n",
        "        \"nameserver\": \"ns1.example.com\"\n",
        "    },\n",
        "    {\n",
        "        \"domain\": \"test.com\",\n",
        "        \"registrar\": \"Registrar-B\",\n",
        "        \"registered\": \"2022-05-20\",\n",
        "        \"expires\": \"2027-05-20\",\n",
        "        \"nameserver\": \"ns1.test.com\"\n",
        "    }\n",
        "]\n",
        "\n",
        "print(\"DOMAIN REGISTRATION SUMMARY\")\n",
        "print(\"---------------------------\")\n",
        "\n",
        "for d in domains:\n",
        "    print(\"\\nDomain:\", d[\"domain\"])\n",
        "    print(\"Registrar:\", d[\"registrar\"])\n",
        "    print(\"Registered:\", d[\"registered\"])\n",
        "    print(\"Expires:\", d[\"expires\"])\n",
        "    print(\"Name Server:\", d[\"nameserver\"])\n",
        "\n",
        "print(\"\\nSHARED REGISTRATION CHARACTERISTICS\")\n",
        "print(\"------------------------------------\")\n",
        "\n",
        "from collections import defaultdict\n",
        "\n",
        "registrars = defaultdict(list)\n",
        "\n",
        "for d in domains:\n",
        "    registrars[d[\"registrar\"]].append(d[\"domain\"])\n",
        "\n",
        "for registrar, names in registrars.items():\n",
        "    if len(names) > 1:\n",
        "        print(\"Registrar:\", registrar)\n",
        "        print(\"Domains:\", names)"
      ]
