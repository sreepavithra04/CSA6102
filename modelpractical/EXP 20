            "Domain: test.com\n",
            "Registrar: Registrar-B\n",
            "Registered: 2022-05-20\n",
            "Expires: 2027-05-20\n",
            "Name Server: ns1.test.com\n",
            "\n",
            "SHARED REGISTRATION CHARACTERISTICS\n",
            "------------------------------------\n",
