      "source": [
        "import re\n",
        "import os\n",
        "from collections import Counter\n",
        "\n",
        "# Create sample text files\n",
        "os.makedirs(\"texts\", exist_ok=True)\n",
        "\n",
        "with open(\"texts/log1.txt\", \"w\") as f:\n",
        "    f.write(\"Contact admin@test.com at 192.168.1.10 http://example.com\")\n",
        "\n",
        "with open(\"texts/log2.txt\", \"w\") as f:\n",
        "    f.write(\"Wallet bc1q1234567890 and visit example.com\")\n",
        "\n",
        "patterns = {\n",
        "    \"IP\": r\"\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b\",\n",
        "    \"URL\": r\"https?://[^\\s]+\",\n",
        "    \"Email\": r\"[\\w.-]+@[\\w.-]+\\.\\w+\",\n",
        "    \"Crypto\": r\"\\b(?:bc1|1|3)[a-zA-Z0-9]{10,}\\b\",\n",
        "    \"Domain\": r\"\\b[\\w.-]+\\.(?:com|org|net)\\b\"\n",
        "}\n",
        "\n",
        "results = {}\n",
        "\n",
        "for file in os.listdir(\"texts\"):\n",
        "    with open(\"texts/\" + file) as f:\n",
        "        text = f.read()\n",
        "\n",
        "    for kind, pattern in patterns.items():\n",
        "        for value in re.findall(pattern, text):\n",
        "            results.setdefault(value, set()).add(file)\n",
        "\n",
        "print(\"CONSOLIDATED INDICATORS\")\n",
        "print(\"-----------------------\")\n",
        "\n",
        "for value, files in results.items():\n",
        "    print(value, \"->\", list(files))"
      ]
