      "source": [
        "emails = [\n",
        "    {\n",
        "        \"sender\": \"admin@company.com\",\n",
        "        \"recipient\": \"user@company.com\",\n",
        "        \"subject\": \"Meeting\",\n",
        "        \"attachment\": \"\",\n",
        "        \"url\": \"\",\n",
        "        \"time\": \"10:00\"\n",
        "    },\n",
        "    {\n",
        "        \"sender\": \"alert@unknown.xyz\",\n",
        "        \"recipient\": \"user@company.com\",\n",
        "        \"subject\": \"Urgent Account Verification\",\n",
        "        \"attachment\": \"invoice.exe\",\n",
        "        \"url\": \"http://fake-site.xyz\",\n",
        "        \"time\": \"02:00\"\n",
        "    }\n",
        "]\n",
        "\n",
        "for mail in emails:\n",
        "    score = 0\n",
        "\n",
        "    if not mail[\"sender\"].endswith(\"@company.com\"):\n",
        "        score += 2\n",
        "\n",
        "    if mail[\"attachment\"].endswith((\".exe\", \".js\", \".bat\")):\n",
        "        score += 3\n",
        "\n",
        "    if mail[\"url\"].startswith(\"http://\"):\n",
        "        score += 2\n",
        "\n",
        "    if \"urgent\" in mail[\"subject\"].lower():\n",
        "        score += 2\n",
        "\n",
        "    if int(mail[\"time\"][:2]) < 6:\n",
        "        score += 1\n",
        "\n",
        "    mail[\"score\"] = score\n",
        "\n",
        "emails.sort(key=lambda x: x[\"score\"], reverse=True)\n",
        "\n",
        "print(\"Emails Requiring Investigation:\")\n",
        "\n",
        "for mail in emails:\n",
        "    if mail[\"score\"] >= 3:\n",
        "        print(\"\\nScore:\", mail[\"score\"])\n",
        "        print(\"Sender:\", mail[\"sender\"])\n",
        "        print(\"Recipient:\", mail[\"recipient\"])\n",
        "        print(\"Subject:\", mail[\"subject\"])\n",
        "        print(\"Attachment:\", mail[\"attachment\"])\n",
        "        print(\"URL:\", mail[\"url\"])\n",
        "        print(\"Time:\", mail[\"time\"])"
      ]
